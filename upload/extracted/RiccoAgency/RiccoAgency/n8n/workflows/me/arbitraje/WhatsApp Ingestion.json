    {
      "parameters": {
        "jsCode": "// Extrae y estandariza mensajes de WhatsApp y Telegram\n// para que un agente LLM los interprete después.\n// NO se hace normalización ni inferencia aquí.\n\nconst input = $(\"WA Webhook\").item.json;\n\n    const platform = 'WhatsApp';\n    const text = input.body.data.message.conversation;\n    const timestamp = new Date(input.body.data.messageTimestamp * 1000).toISOString();\n    const senderId = input.body.data.participantPn || '';\n    const messageId = input.body.data.key?.id || '';\n    const isBot = false;\n\n  let contact = null;\n  const contactMatch = text.match(/(?:PV|privado|mensaje privado|escribirme|llam[ae])\\s*[:\\-]?\\s*(\\+?53\\s?5\\s?\\d{7,8}|\\d{8})/i);\n  if (contactMatch) {\n    contact = contactMatch[1].replace(/\\D/g, ''); // Normaliza a 56694233\n  } else {\n    // Buscar número directo en formato cubano\n    const phoneMatch = text.match(/(\\+53\\s?5\\s?\\d{7,8}|\\b5\\d{7,8}\\b)/);\n    if (phoneMatch) {\n      contact = phoneMatch[1].replace(/\\D/g, '');\n    }\n  }\n\n  // ─── Construir objeto estandarizado ─────────────────\n  return  {\n    platform,\n    text, // ✅ Texto original intacto\n    timestamp,\n    contact, // número limpio o null\n    sender_id: senderId,\n    message_id: messageId,\n    is_bot: isBot\n  };"
      },
