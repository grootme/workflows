# ═══════════════════════════════════════════════════════════════════════════
# JARVIS Enterprise — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════

# ── n8n Configuration ─────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_USER=admin
N8N_PASSWORD=changeme_please_use_strong_password

# ── PostgreSQL ────────────────────────────────────────────────────────────
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=changeme_please_use_strong_password

# ── Qdrant (Vector Database) ──────────────────────────────────────────────
QDRANT_API_KEY=

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_please_use_strong_password

# ── Nginx / SSL ──────────────────────────────────────────────────────────
SSL_CERT_PATH=./nginx/ssl/cert.pem
SSL_KEY_PATH=./nginx/ssl/key.pem

# ── Grafana ──────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_please_use_strong_password

# ── API Keys (configure before first run) ────────────────────────────────
OPENAI_API_KEY=sk-...
GOOGLE_GEMINI_API_KEY=AIza...

# ── Google Workspace OAuth2 ──────────────────────────────────────────────
# Configure via n8n UI: Settings > Credentials > Add Credential
# Required: Google Calendar OAuth2, Gmail OAuth2, Google Contacts OAuth2

# ── Telegram Bot ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# ── WhatsApp (Evolution API) ─────────────────────────────────────────────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=your-key

# ── Anthropic (Claude Sonnet) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Zep (Enterprise Memory) ──────────────────────────────────────────────
ZEP_API_KEY=your-zep-key
