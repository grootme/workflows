      "parameters": {
        "initialMessages": [
          {
            "role": "assistant",
            "content": "Soy tu Asistente de Gestión de Construcción. Gestiono proyectos, materiales, presupuesto, personal y cronogramas de obra. ¿En qué puedo ayudarte?"
          }
        ]
      },
