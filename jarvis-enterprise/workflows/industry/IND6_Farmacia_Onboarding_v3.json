    {
      "parameters": {
        "content": "Farmacia / Pharmacy Onboarding\n\nFLOW: WhatsApp Consult \u2192 CRM Patient \u2192 Stripe Plan \u2192 Teams Telemedicine \u2192 SMS Reminders\n\nPlatforms: WhatsApp, CRM, Stripe, Twilio SMS, Teams\nTiers: Basic (Rx) / Plus (Telemedicine+Delivery) / Premium (Full Care)\nPipeline: Lead \u2192 Consultation \u2192 Registered \u2192 Payment \u2192 Active",
        "width": 300,
        "height": 200
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -2200,
        -400
