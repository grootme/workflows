    },
    {
      "parameters": {
        "content": "Multi-Industry Onboarding\n\nGYM: Quiz \u2192 Register \u2192 Plan \u2192 Orientation \u2192 Track\nFARMACIA: Consult \u2192 Register \u2192 Plan \u2192 Telemedicine \u2192 Track\nABOGADOS: Consult \u2192 Register \u2192 Plan \u2192 Meeting \u2192 Track\n\nCOMMON: Lead \u2192 CRM \u2192 Stripe \u2192 Schedule \u2192 Follow-up",
        "width": 300,
        "height": 200
