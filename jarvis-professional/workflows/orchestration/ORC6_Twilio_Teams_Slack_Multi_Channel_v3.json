    {
      "parameters": {
        "content": "Multi-Channel Communication\n\nTWILIO: SMS + WhatsApp + Voice + OTP\nTEAMS: Messages + Cards + Meetings\nSLACK: Messages + Blocks + Search + Channels\n\nCROSS-CHANNEL:\n  Broadcast \u2192 Escalation \u2192 Routing \u2192 Sync",
        "width": 300,
        "height": 200
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -2200,
        -400
