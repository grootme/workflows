        "initialMessages": [
          {
            "role": "assistant",
            "content": "Soy tu Asistente Freelance. Gestiono proyectos en CRM, facturaci\u00f3n en Stripe, comunicaci\u00f3n en Slack, agenda en Calendar y emails en Gmail. \u00bfEn qu\u00e9 te ayudo?"
          }
